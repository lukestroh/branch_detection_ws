<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="pruning_robot">

  <!-- robot name parameter -->
  <xacro:arg name="name" default="ur"/>
  <!-- parameters -->
  <xacro:arg name="ur_prefix" default="ur5e__" />

  <xacro:include filename="$(find branch_detection_system_moveit_config)/srdf/robot_amiga_macro.srdf.xacro"/>

  <xacro:ur_srdf name="$(arg name)" arm_prefix="$(arg ur_prefix)"/>

</robot>